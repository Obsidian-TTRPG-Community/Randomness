node_modules/
# main.js is committed — it's the build artifact users install. Some
# Obsidian plugins gitignore it and only ship via Release assets; we
# keep it tracked so a clean clone is immediately installable manually.
*.log
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# release artifacts staged locally, uploaded to GitHub releases by hand
*.zip

# Doc-example harness build artefact (see docs-tools/docroll.ts)
docs-tools/docroll.cjs

# Fallback folder used when a tool can't delete files directly — it is
# scratch, never part of the plugin. 675 stale git temp objects reached
# GitHub through it once already.
_to_delete/
