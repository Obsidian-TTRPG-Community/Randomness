// names.rdm
// =====================================================================
// Large race- and gender-aware NPC name pool. Built for Town Forge's
// place templates (which roll a portrait, then draw a matching name and
// check it against the town's cast list), but usable anywhere.
//
// Entry tables:
//   [#<race>_<gender> TF-PersonName]  - full name, e.g. [#elf_female TF-PersonName]
//   [#<race>_<gender> TF-FirstName]   - first name only
//   [#<race> TF-Surname]              - surname only
//
// Races: human, elf, halfelf, halforc, gnome, goblin. Half-elves draw
// from both parent cultures. Unknown races should be mapped to human by
// the caller.
//
// Surnames mix a curated list with a prefix+suffix compound table, so the
// pool is tens of thousands of full names per race/gender bucket rather
// than the few hundred a flat list gives.
// =====================================================================

Formatting: text

Table: TF-PersonName
Type: Dictionary
human_male: [#human_male TF-FirstName] [#human TF-Surname]
human_female: [#human_female TF-FirstName] [#human TF-Surname]
elf_male: [#elf_male TF-FirstName] [#elf TF-Surname]
elf_female: [#elf_female TF-FirstName] [#elf TF-Surname]
halforc_male: [#halforc_male TF-FirstName] [#halforc TF-Surname]
halforc_female: [#halforc_female TF-FirstName] [#halforc TF-Surname]
gnome_male: [#gnome_male TF-FirstName] [#gnome TF-Surname]
gnome_female: [#gnome_female TF-FirstName] [#gnome TF-Surname]
goblin_male: [#goblin_male TF-FirstName] [#goblin TF-Surname]
goblin_female: [#goblin_female TF-FirstName] [#goblin TF-Surname]
halfelf_male: [#halfelf_male TF-FirstName] [#halfelf TF-Surname]
halfelf_female: [#halfelf_female TF-FirstName] [#halfelf TF-Surname]

Table: TF-FirstName
Type: Dictionary
human_male: [@TF-First-Human-Male]
human_female: [@TF-First-Human-Female]
elf_male: [@TF-First-Elf-Male]
elf_female: [@TF-First-Elf-Female]
halforc_male: [@TF-First-HalfOrc-Male]
halforc_female: [@TF-First-HalfOrc-Female]
gnome_male: [@TF-First-Gnome-Male]
gnome_female: [@TF-First-Gnome-Female]
goblin_male: [@TF-First-Goblin-Male]
goblin_female: [@TF-First-Goblin-Female]
halfelf_male: [@TF-First-HalfElf-Male]
halfelf_female: [@TF-First-HalfElf-Female]

Table: TF-Surname
Type: Dictionary
human: [@TF-Last-Human]
elf: [@TF-Last-Elf]
halforc: [@TF-Last-HalfOrc]
gnome: [@TF-Last-Gnome]
goblin: [@TF-Last-Goblin]
halfelf: [@TF-Last-HalfElf]

